{
  "version": 3,
  "configurePresets": [
    {
      "name": "wasm-release-preset",
      "displayName": "WASM Release (Emscripten)",
      "description": "WebAssembly build via Emscripten + vcpkg.",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/cmake-build-wasm",
      "environment": {
        "EMSDK":        "D:/programs/emsdk",
        "EMSDK_NODE":   "D:/programs/emsdk/node/22.16.0_64bit/bin/node.exe",
        "EMSDK_PYTHON": "D:/programs/emsdk/python/3.13.3_64bit/python.exe",
        "PATH":         "D:/programs/emsdk/upstream/emscripten;D:/programs/emsdk;$penv{PATH}"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE":               "Release",
        "CMAKE_TOOLCHAIN_FILE":           "C:/Users/mateu/.vcpkg-clion/vcpkg/scripts/buildsystems/vcpkg.cmake",
        "VCPKG_CHAINLOAD_TOOLCHAIN_FILE": "D:/programs/emsdk/upstream/emscripten/cmake/Modules/Platform/Emscripten.cmake",
        "VCPKG_TARGET_TRIPLET":           "wasm32-emscripten",
        "BUILD_WASM_BINDINGS":            "ON",
        "BUILD_TESTING":                  "OFF",
        "BUILD_PYTHON_BINDINGS":          "OFF",
        "CMAKE_CXX_FLAGS":                "-fexceptions"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "wasm-release",
      "displayName": "WASM Release (Emscripten)",
      "configurePreset": "wasm-release"
    }
  ]
}